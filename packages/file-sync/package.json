{
  "name": "file-sync",
  "version": "0.0.1",
  "private": true,
  "description": "Live file sync between the agent-console file hub and the apps editing files: text changes, rebase, and the RPC protocol.",
  "type": "module",
  "license": "MIT",
  "author": "Nikolas Stow",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./TextChange": {
      "types": "./src/TextChange.ts",
      "default": "./src/TextChange.ts"
    },
    "./Rebase": {
      "types": "./src/Rebase.ts",
      "default": "./src/Rebase.ts"
    },
    "./FileSync": {
      "types": "./src/FileSync.ts",
      "default": "./src/FileSync.ts"
    }
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102",
    "fast-diff": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
