{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalTimers": "off",
          "globalDate": "off",
          "newPromise": "off",
          "asyncFunction": "off"
        }
      }
    ]
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["../../../node_modules", "../../../dist", "./**/*.test.tsx"]
}
