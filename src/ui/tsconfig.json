{
  // Shared UI core (data / route / atom-react). Same Effect diagnostic suite as root, with
  // Effect-purity + anyUnknownInErrorContext off (`Date.now`, loose atom `R`). Root excludes `src/ui/**`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
            "anyUnknownInErrorContext": "off",
            "asyncFunction": "off",
            "catchAllToMapError": "error",
            "catchUnfailableEffect": "error",
            "cryptoRandomUUID": "error",
            "cryptoRandomUUIDInEffect": "error",
            "deterministicKeys": "error",
            "duplicatePackage": "error",
            "effectDoNotation": "error",
            "effectFnIife": "error",
            "effectFnOpportunity": "error",
            "effectGenUsesAdapter": "error",
            "effectInFailure": "error",
            "effectInVoidSuccess": "error",
            "effectMapFlatten": "error",
            "effectMapVoid": "error",
            "effectSucceedWithVoid": "error",
            "extendsNativeError": "error",
            "flatMapToMap": "error",
            "genericEffectServices": "error",
            "globalConsole": "off",
            "globalConsoleInEffect": "error",
            "globalDate": "off",
            "globalDateInEffect": "error",
            "globalErrorInEffectCatch": "error",
            "globalErrorInEffectFailure": "error",
            "globalFetch": "error",
            "globalFetchInEffect": "error",
            "globalRandom": "error",
            "globalRandomInEffect": "error",
            "globalTimers": "off",
            "globalTimersInEffect": "error",
            "instanceOfSchema": "error",
            "layerMergeAllWithDependencies": "error",
            "lazyPromiseInEffectSync": "error",
            "leakingRequirements": "error",
            "missedPipeableOpportunity": "error",
            "missingEffectServiceDependency": "error",
            "missingLayerContext": "error",
            "multipleEffectProvide": "error",
            "nestedEffectGenYield": "error",
            "newPromise": "off",
            "nodeBuiltinImport": "off",
            "outdatedApi": "error",
            "outdatedEffectCodegen": "error",
            "preferSchemaOverJson": "error",
            "processEnv": "error",
            "processEnvInEffect": "error",
            "redundantSchemaTagIdentifier": "error",
            "returnEffectInGen": "error",
            "runEffectInsideEffect": "error",
            "schemaStructWithTag": "error",
            "schemaSyncInEffect": "error",
            "schemaUnionOfLiterals": "error",
            "scopeInLayerEffect": "error",
            "serviceNotAsClass": "error",
            "strictBooleanExpressions": "error",
            "strictEffectProvide": "message",
            "tryCatchInEffectGen": "error",
            "unknownInEffectCatch": "error",
            "unnecessaryArrowBlock": "error",
            "unnecessaryEffectGen": "error",
            "unnecessaryFailYieldableError": "error",
            "unnecessaryPipe": "error",
            "unnecessaryPipeChain": "error",
            "unsafeEffectTypeAssertion": "message",
            "unsupportedServiceAccessors": "error"
          }
      }
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../Observe.ts",
    "../internal/observe.ts",
    "../internal/observeUse.ts",
    "../../test/observe.test.ts",
    "../../test/observe.test-d.ts",
    "../../test/ui-workpool-view-pack.test.ts",
    "../../test/ui-family-view-packs.test.ts",
    "../../test/ui-bundle-observe.test.ts",
    "../../test/ui-bundle-observe.test-d.ts",
    "../../test/ui-view-data.test.ts",
    "../../test/ui-view-data.test-d.ts",
    "../../test/ui-routes.test.ts",
    "../../test/ui-routes.test-d.ts",
    "../../test/ui-routes-from-effect.test-d.ts",
    "../../test/ui-from-effect-typed.test-d.ts",
    "../../test/route-from-effect.test-d.ts",
    "../../test/page-make.test-d.ts",
    "../../test/ui-router.test.ts",
    "../../test/ui-router.test-d.ts",
    "../../test/ui-router-mini-docs.test-d.ts",
    "../../test/ui-file-router-proto.test-d.ts",
    "../../test/ui-file-router.test.ts",
    "../../test/ui-file-router.test-d.ts",
    "../../test/ui-page.test-d.ts",
    "../../examples/ui/file-router/**/*.ts",
    "./Page.ts",
    "../vite/fileRouter.ts",
    "../internal/fileRouterPaths.ts",
    "../internal/uiFileRouter.ts"
  ],
  "exclude": ["../../node_modules", "../../dist"]
}
