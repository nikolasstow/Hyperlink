# Dependencies
node_modules
# The wrong-package-manager lockfiles stay ignored — this repo is pnpm.
package-lock.json
yarn.lock
# pnpm-lock.yaml is deliberately committed: EAS Build installs with
# --frozen-lockfile and detects the package manager from the lockfile in the
# uploaded archive. With it ignored, EAS found no lockfile, defaulted to
# yarn, and then failed on the root packageManager: pnpm@ field.

# Build outputs
dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
.env.keys
# dotenvx: encrypted docs/site/.env is commit-safe (private key stays in .env.keys)
!docs/site/.env
!docs/site/.env.example
docs/site/.env.keys

