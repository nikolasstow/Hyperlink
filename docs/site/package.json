{
  "name": "hyperlink-ts-docs",
  "private": true,
  "type": "module",
  "description": "Official docs/website for hyperlink-ts — bespoke Waku RSC app, Djot content, Effect pipeline.",
  "scripts": {
    "predev": "[ -f api-data/index.json ] && [ -z \"$DOCS_REGEN\" ] && (echo 'api-data present — fast dev start (DOCS_REGEN=1 pnpm dev to regenerate)' && tsx scripts/gen-search.ts && tsx scripts/gen-llms.ts) || (tsx scripts/gen-api.ts && NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/gen-hovers.ts && tsx scripts/gen-search.ts && tsx scripts/gen-llms.ts)",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 waku dev --host 0.0.0.0 --port 5190",
    "prebuild": "tsx scripts/gen-api.ts && NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/gen-hovers.ts && tsx scripts/gen-search.ts && tsx scripts/gen-llms.ts && tsx scripts/check-links.ts",
    "build": "waku build",
    "postbuild": "node scripts/check-ssg.mjs",
    "preview": "HOST=0.0.0.0 PORT=5190 node scripts/serve-production.mjs",
    "docs:manifest": "tsx scripts/gen-manifest.ts",
    "docs:manifest:check": "tsx scripts/gen-manifest.ts --check",
    "docs:api": "tsx scripts/gen-api.ts && NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/gen-hovers.ts && tsx scripts/gen-search.ts && tsx scripts/gen-llms.ts",
    "docs:restamp-hovers": "tsx scripts/restamp-hover-cache.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check-links": "tsx scripts/check-links.ts",
    "docs:check-ssg": "node scripts/check-ssg.mjs",
    "docs:smoke": "node scripts/browser-smoke.mjs",
    "docs:smoke:search": "node scripts/search-smoke.mjs",
    "docs:smoke:routes": "node scripts/live-routes-smoke.mjs",
    "docs:verify": "vitest run && tsx scripts/check-links.ts && node scripts/check-ssg.mjs && node scripts/browser-smoke.mjs && node scripts/search-smoke.mjs",
    "env:run": "dotenvx run --",
    "env:set": "dotenvx set",
    "env:get": "dotenvx get",
    "cf:ensure": "dotenvx run -- ./scripts/cf-edge-cache.sh ensure",
    "cf:purge": "dotenvx run -- ./scripts/cf-edge-cache.sh purge",
    "cf:status": "dotenvx run -- ./scripts/cf-edge-cache.sh status",
    "deploy:do": "dotenvx run -- ./scripts/deploy-do.sh",
    "op:bootstrap": "./scripts/op-bootstrap-docs-secrets.sh",
    "op:restore-keys": "./scripts/op-restore-env-keys.sh"
  },
  "dependencies": {
    "@djot/djot": "^0.3.2",
    "@effect/platform-node": "4.0.0-beta.102",
    "@nikscripts/docgen": "file:../docgen",
    "@shikijs/twoslash": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "hono": "^4.12.14",
    "lucide-react": "^1.24.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "minisearch": "^7.2.0",
    "prettier": "2.8.8",
    "radix-ui": "^1.6.2",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-server-dom-webpack": "~19.2.6",
    "recharts": "^3.9.2",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "twoslash": "0.3.9",
    "typescript": "^5.9.0",
    "waku": "1.0.0-beta.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.19.0",
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "4.0.0-beta.102",
    "@tailwindcss/vite": "^4.3.2",
    "@types/compression": "^1.8.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "compression": "^1.8.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "packageManager": "pnpm@10.16.1"
}
