# Docs site deploy / edge secrets (dotenvx).
# Copy is not required — encrypted `.env` is committed; set values with:
#   pnpm exec dotenvx set KEY 'value'
# Private key lives in `.env.keys` (gitignored) — back it up to 1Password.

# Cloudflare (Zone.Zone Read + Zone.Cache Rules Edit + Zone.Cache Purge)
CLOUDFLARE_API_TOKEN=
# Optional — looked up from hyperlink.cool when unset
CLOUDFLARE_ZONE_ID=

# Absolute origin stamped into sitemap / llms on deploy
DOCS_SITE_ORIGIN=https://dev.hyperlink.cool

# DigitalOcean App Platform app id (hyperlink-docs). doctl auth stays in doctl config.
DO_DOCS_APP_ID=ed0a18b6-946a-4219-a427-af456d181755
